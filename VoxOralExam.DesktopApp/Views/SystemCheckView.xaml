<UserControl x:Class="VoxOralExam.DesktopApp.Views.SystemCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="#F5F5F5">
        <Border Background="White" CornerRadius="12" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="480">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Kiểm tra hệ thống" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Quét ứng dụng nền, thiết bị ảo và số màn hình"
                           Foreground="Gray" Margin="0,4,0,20" />

                <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,0,0,20">
                    <TextBlock Foreground="#92400E" TextWrapping="Wrap"
                               Text="TODO (§B): quét remote-control (AnyDesk/TeamViewer), screen recorder (OBS), CAMERA/AUDIO ảo (ưu tiên cao nhất), dấu hiệu máy ảo và số màn hình. Blocklist lấy từ server; enforcement phân tier (Service/Helper/DetectOnly). Hiện là placeholder." />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Content="Quay lại" Command="{Binding BackCommand}"
                            Padding="16,8" Margin="0,0,10,0" />
                    <Button Content="Tiếp tục (tạm)" Command="{Binding ContinueCommand}"
                            Padding="16,8" Background="#2563EB" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
