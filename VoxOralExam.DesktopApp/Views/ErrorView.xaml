<UserControl x:Class="VoxOralExam.DesktopApp.Views.ErrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="560">
        <Border Background="White"
                Padding="32"
                CornerRadius="20"
                BorderBrush="#FECACA"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.18" />
            </Border.Effect>
            <StackPanel>
                <Border Width="68"
                        Height="68"
                        CornerRadius="34"
                        Background="#FEE2E2"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18">
                    <TextBlock Text="!"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#DC2626"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Bài thi đã kết thúc"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           TextAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock Text="{Binding EndScreenMessage}"
                           FontSize="16"
                           Foreground="#475569"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
