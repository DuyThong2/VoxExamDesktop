<UserControl x:Class="VoxOralExam.DesktopApp.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="780" d:DesignWidth="460">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Border Background="White"
                CornerRadius="12"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="380">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Vox Oral Exam"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Đăng nhập để bắt đầu thi"
                               FontSize="13"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24" />

                    <TextBlock Text="Email"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="EmailBox"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Padding="10,8"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1"
                             GotFocus="Field_GotFocus" />

                    <TextBlock Text="Mật khẩu"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,16,0,6" />
                    <PasswordBox x:Name="PasswordBox"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 FontSize="14"
                                 Padding="10,8"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="Red"
                               FontSize="12"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                               TextWrapping="Wrap" />

                    <Button Content="Đăng nhập"
                            Command="{Binding LoginCommand}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="0,10"
                            Margin="0,20,0,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1D4ED8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#1E40AF" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#93C5FD" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

    <!-- Ẩn hẳn khi chưa cấu hình GOOGLE_CLIENT_ID, thay vì hiện một nút luôn hỏng. Bản dựng trỏ
                         vào môi trường chưa bật Google vẫn đăng nhập bằng mật khẩu bình thường.
                         Xem LoginViewModel.IsGoogleSignInAvailable. -->
                    <Grid Margin="0,18,0,0"
                          Visibility="{Binding IsGoogleSignInAvailable, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1" Background="#E5E7EB" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="hoặc"
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       Margin="10,0" />
                            <Border Grid.Column="2" Height="1" Background="#E5E7EB" VerticalAlignment="Center" />
                        </Grid>

                        <Button Grid.Row="1"
                                Content="Đăng nhập bằng Google"
                                Command="{Binding GoogleLoginCommand}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Padding="0,10"
                                Margin="0,14,0,0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Foreground" Value="#1F2937" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="#D1D5DB"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F9FAFB" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#F3F4F6" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="#9CA3AF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
