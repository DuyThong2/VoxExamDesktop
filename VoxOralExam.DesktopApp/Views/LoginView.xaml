<Window x:Class="VoxOralExam.DesktopApp.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập"
        Height="780"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Border Background="White"
                CornerRadius="12"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="380">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Vox Oral Exam"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Đăng nhập để bắt đầu thi"
                               FontSize="13"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24" />

                    <TextBlock Text="Email"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="EmailBox"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Padding="10,8"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1"
                             GotFocus="Field_GotFocus" />

                    <TextBlock Text="Mật khẩu"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,16,0,6" />
                    <PasswordBox x:Name="PasswordBox"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 FontSize="14"
                                 Padding="10,8"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1" />

                    <Border Margin="0,18,0,0"
                            Padding="14"
                            CornerRadius="10"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Kiểm tra thiết bị"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Microphone cho bài thi"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,6" />
                            <ComboBox ItemsSource="{Binding AudioInputDevices}"
                                      SelectedItem="{Binding SelectedAudioInput}"
                                      DisplayMemberPath="DisplayName"
                                      FontSize="13"
                                      Padding="8,6" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Test tai nghe"
                                        Command="{Binding PlayTestSoundCommand}"
                                        Padding="10,6"
                                        Margin="0,0,8,0" />
                                <Button Padding="10,6"
                                        Command="{Binding ToggleMicTestCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Test mic" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMicTesting}" Value="True">
                                                    <Setter Property="Content" Value="Dừng mic test" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Padding="10,6"
                                        Margin="8,0,0,0"
                                        Command="{Binding ToggleCameraTestCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Test camera" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCameraTesting}" Value="True">
                                                    <Setter Property="Content" Value="Dừng camera" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="Mức mic"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,6" />
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Height="10"
                                         Value="{Binding MicrophoneLevel}" />

                            <Border Height="170"
                                    Margin="0,12,0,0"
                                    Background="#0F172A"
                                    CornerRadius="8"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding CameraPreview}" Stretch="UniformToFill" />
                                    <TextBlock Text="Bật test camera để xem trước"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CameraPreview}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding DeviceTestStatus}"
                                       FontSize="12"
                                       Foreground="#475569"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="Red"
                               FontSize="12"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                               TextWrapping="Wrap" />

                    <Button Content="Đăng nhập"
                            Command="{Binding LoginCommand}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="0,10"
                            Margin="0,20,0,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1D4ED8" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#1E40AF" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#93C5FD" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
