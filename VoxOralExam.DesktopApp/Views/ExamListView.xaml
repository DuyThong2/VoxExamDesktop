<UserControl x:Class="VoxOralExam.DesktopApp.Views.ExamListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="850">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🎓 Vox Oral Exam"
                       FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Danh sách bài thi sắp tới / đang diễn ra"
                       FontSize="14" Foreground="Gray" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Loading indicator -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,20,0,20">
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
            <TextBlock Text="Đang tải danh sách bài thi..."
                       Foreground="Gray" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Error message -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red" FontSize="13"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />

        <!-- Exam list -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding Exams}"
                  BorderThickness="0"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8"
                            Padding="16" Margin="0,0,0,10"
                            BorderBrush="#E5E7EB" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08" />
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="16" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock FontSize="13" Foreground="Gray">
                                        <Run Text="{Binding Subject}" />
                                        <Run Text=" • " />
                                        <Run Text="{Binding Duration, StringFormat='{}{0} phút'}" />
                                        <Run Text=" • " />
                                        <Run Text="{Binding ExamDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="Bắt đầu thi"
                                        Command="{Binding DataContext.StartExamCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding}"
                                        Padding="16,8"
                                        FontSize="13" FontWeight="SemiBold"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2563EB" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#1D4ED8" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" Value="#1E40AF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Refresh button -->
        <Button Grid.Row="3" Content="🔄 Làm mới"
                Command="{Binding RefreshCommand}"
                HorizontalAlignment="Right"
                Padding="16,8" Margin="0,16,0,0"
                FontSize="13" Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="Foreground" Value="#374151" />
                    <Setter Property="BorderBrush" Value="#D1D5DB" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F3F4F6" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
