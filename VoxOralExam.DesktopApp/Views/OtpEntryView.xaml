<UserControl x:Class="VoxOralExam.DesktopApp.Views.OtpEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Border Background="White" CornerRadius="12" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="440">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Nhập mã OTP" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding ExamTitle}" Foreground="Gray" Margin="0,4,0,4" />
                <TextBlock Text="Nhập mã hiển thị trên màn hình của giám thị coi thi."
                           Foreground="#475569" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBox x:Name="OtpBox"
                         Text="{Binding Otp, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="{Binding OtpLength}"
                         FontSize="30" FontWeight="Bold"
                         Padding="10,10" HorizontalContentAlignment="Center"
                         BorderBrush="#CBD5E1" BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVerifying}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Verifying / error status. The two are mutually exclusive (VerifyAsync clears
                     HasError before setting IsVerifying), so they share one slot. MinHeight reserves
                     it while idle: without that the card grows when verification starts, and since it
                     is centred every field jumps as the student hits Xác nhận. -->
                <Grid MinHeight="36" Margin="0,14,0,0">
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding IsVerifying, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar IsIndeterminate="True" Height="4" Foreground="#2563EB"
                                     Background="#E2E8F0" BorderThickness="0" />
                        <TextBlock Text="Đang xác thực..." Foreground="#64748B" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,9,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Quay lại" Command="{Binding BackCommand}"
                            Padding="16,8" Margin="0,0,10,0" />
                    <Button Content="Xác nhận" Command="{Binding VerifyCommand}"
                            Padding="20,8" Background="#2563EB" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
