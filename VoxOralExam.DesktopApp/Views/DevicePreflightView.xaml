<UserControl x:Class="VoxOralExam.DesktopApp.Views.DevicePreflightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="900">
    <Grid Background="#F5F5F5">
        <Border Background="White" CornerRadius="12" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="440" MaxWidth="520">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                <StackPanel>
                    <TextBlock Text="Kiểm tra thiết bị" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Kiểm tra camera, microphone và âm thanh trước khi vào thi."
                               FontSize="13" Foreground="Gray" Margin="0,4,0,16" />

                    <!-- Lựa chọn giám sát, chỉ hiện với kỳ thi cho học viên tự chọn và phiên chưa
                         chốt. Đặt TRÊN phần kiểm tra thiết bị vì nó quyết định thiết bị nào sẽ được
                         kiểm tra; đảo thứ tự thì học viên đọc kết quả trước khi biết nó nói về
                         cái gì. -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStreamChoices}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Bạn muốn chia sẻ gì trong buổi thi?"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2" />
                            <TextBlock Text="Kỳ thi này cho phép bạn tự chọn. Lựa chọn được chốt khi bấm Vào thi và không đổi được sau đó."
                                       FontSize="11" Foreground="#475569" TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <!-- ListBox + SelectedItem chứ không phải ItemsControl + RadioButton:
                                 ràng buộc IsChecked của từng radio về một thuộc tính "mục đang
                                 chọn" cần converter so sánh, còn ListBox vốn đã có sẵn khái niệm
                                 đó. ControlTemplate chỉ đổi hình dáng container thành radio. -->
                            <ListBox ItemsSource="{Binding StreamChoices}"
                                     SelectedItem="{Binding SelectedStreamChoice, Mode=TwoWay}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <RadioButton GroupName="StreamChoice"
                                                                 Margin="0,0,0,6"
                                                                 IsChecked="{Binding IsSelected,
                                                                                     RelativeSource={RelativeSource TemplatedParent},
                                                                                     Mode=TwoWay}">
                                                        <ContentPresenter />
                                                    </RadioButton>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Label}" FontSize="13" />
                                            <TextBlock Text="{Binding Hint}" FontSize="11"
                                                       Foreground="#64748B" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Thiết bị giám sát bắt buộc. Đặt trên cùng vì đây là phần DUY NHẤT quyết định
                         học viên có được vào thi hay không; mic/loa bên dưới chỉ là tiện nghi. -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStreamChecks}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Thiết bị giám sát bắt buộc"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding StreamChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Top" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="✕" />
                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                                <Setter Property="Text" Value="✓" />
                                                                <Setter Property="Foreground" Value="#16A34A" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                           Foreground="#475569" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Kiểm tra lại" HorizontalAlignment="Left"
                                    Command="{Binding RecheckStreamsCommand}"
                                    Padding="10,6" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Đang kiểm tra thiết bị giám sát..."
                               FontSize="12" Foreground="#475569" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCheckingStreams}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Microphone cho bài thi"
                               FontSize="12" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <ComboBox ItemsSource="{Binding AudioInputDevices}"
                              SelectedItem="{Binding SelectedAudioInput}"
                              DisplayMemberPath="DisplayName"
                              FontSize="13" Padding="8,6" />

                    <TextBlock Text="Loa/tai nghe cho bài thi"
                               FontSize="12" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <ComboBox ItemsSource="{Binding AudioOutputDevices}"
                              SelectedItem="{Binding SelectedAudioOutput}"
                              DisplayMemberPath="DisplayName"
                              FontSize="13" Padding="8,6" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Test tai nghe"
                                Command="{Binding PlayTestSoundCommand}"
                                Padding="10,6" Margin="0,0,8,0" />
                        <Button Padding="10,6" Command="{Binding ToggleMicTestCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="Test mic" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMicTesting}" Value="True">
                                            <Setter Property="Content" Value="Dừng mic test" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Padding="10,6" Margin="8,0,0,0" Command="{Binding ToggleCameraTestCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="Test camera" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCameraTesting}" Value="True">
                                            <Setter Property="Content" Value="Dừng camera" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Mức mic" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <ProgressBar Minimum="0" Maximum="100" Height="10" Value="{Binding MicrophoneLevel}" />

                    <Border Height="220" Margin="0,12,0,0"
                            Background="#0F172A" CornerRadius="8"
                            BorderBrush="#CBD5E1" BorderThickness="1">
                        <Grid>
                            <Image Source="{Binding CameraPreview}" Stretch="UniformToFill" />
                            <TextBlock Text="Bật test camera để xem trước"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CameraPreview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding DeviceTestStatus}"
                               FontSize="12" Foreground="#475569"
                               Margin="0,10,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Quay lại" Command="{Binding BackCommand}"
                                Padding="16,8" Margin="0,0,10,0" />
                        <!-- Bị vô hiệu hoá qua EnterExamCommand.CanExecute khi còn thiết bị giám sát
                             chưa đạt. Phải đổi cả màu: một nút xanh lá vẫn trông như bấm được, và
                             học viên sẽ tưởng ứng dụng treo chứ không hiểu là mình đang bị chặn. -->
                        <Button Content="Vào thi" Command="{Binding EnterExamCommand}"
                                Padding="20,8" Foreground="White" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#16A34A" />
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#94A3B8" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
