<Window x:Class="VoxOralExam.DesktopApp.Views.ExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VoxOralExam.DesktopApp.Controls"
        Title="Vox Oral Exam - Ky thi van dap"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="CameraPreviewBorder"
                Grid.Row="1"
                Width="220"
                Height="165"
                Background="#1E293B"
                CornerRadius="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20"
                Cursor="SizeAll"
                MouseLeftButtonDown="CameraPreview_MouseLeftButtonDown"
                MouseMove="CameraPreview_MouseMove"
                MouseLeftButtonUp="CameraPreview_MouseLeftButtonUp"
                Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#334155" CornerRadius="10,10,0,0" Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCameraOn}" Value="True">
                                            <Setter Property="Fill" Value="#22C55E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCameraOn}" Value="False">
                                            <Setter Property="Fill" Value="#EF4444" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="Camera" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" ClipToBounds="True">
                    <Image Source="{Binding CameraPreview}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="LowQuality" />

                    <Border BorderBrush="#22C55E"
                            BorderThickness="4"
                            CornerRadius="10"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStudentSpeaking}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="StudentSpeakingGlowStoryboard">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                      From="0.25"
                                                                      To="0.9"
                                                                      Duration="0:0:0.35"
                                                                      AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="StudentSpeakingGlowStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCameraOn}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Camera off" FontSize="14" HorizontalAlignment="Center" />
                        <TextBlock Text="Camera khong hoat dong"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Margin="4,4,4,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="0" Background="#1E293B" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="36" Height="36" Fill="#3B82F6" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StudentName}" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Foreground="#94A3B8" FontSize="12">
                            <Run Text="Ma SV: " />
                            <Run Text="{Binding StudentId}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Thoi gian con lai" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding TimeRemaining}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ExamTitle}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Right">
                        <Run Text="Cau " />
                        <Run Text="{Binding QuestionNumber}" />
                        <Run Text=" / " />
                        <Run Text="{Binding TotalQuestions}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#0F172A"
                        CornerRadius="12"
                        Margin="0,0,0,16"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.15" />
                    </Border.Effect>

                    <Grid>
                        <controls:AvatarVideoHost VideoFrame="{Binding AvatarVideoFrame}" IsSpeaking="{Binding IsAvatarSpeaking}" />

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,6,0" />
                                <TextBlock Text="AI examiner" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding AiStatus}"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="0,8,0,0"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"
                                       Width="220" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="20"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#EFF6FF" CornerRadius="4" Padding="8,4">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#2563EB">
                                    <Run Text="CAU " />
                                    <Run Text="{Binding QuestionNumber}" />
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding ExamTitle}"
                                       FontSize="12"
                                       Foreground="Gray"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding CurrentQuestion}"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   Margin="0,0,0,16" />

                        <Border Grid.Row="2"
                                Margin="0,0,0,16"
                                Padding="12"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10">
                            <!-- Only takes up space/shows a border when the current question actually has a
                                 displayable asset. Previously this Border had no Visibility of its own, so it
                                 (and its "no attachment" placeholder text) rendered on every question, including
                                 ones with no asset at all. -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasImageAsset}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasTextPassageAsset}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasMediaAsset}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Image Source="{Binding CurrentQuestionAssetImage}"
                                       Stretch="Uniform"
                                       MaxHeight="260">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasImageAsset}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              MaxHeight="260"
                                              Padding="4">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTextPassageAsset}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <TextBlock Text="{Binding CurrentQuestionAsset.Transcript}"
                                               TextWrapping="Wrap"
                                               LineHeight="24"
                                               FontSize="15"
                                               Foreground="#0F172A" />
                                </ScrollViewer>

                                <MediaElement x:Name="QuestionAssetMedia"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Stop"
                                              Stretch="Uniform"
                                              Source="{Binding CurrentQuestionMediaSource, NotifyOnTargetUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                                              TargetUpdated="QuestionAssetMedia_TargetUpdated"
                                              MediaEnded="QuestionAssetMedia_MediaEnded"
                                              MediaFailed="QuestionAssetMedia_MediaFailed"
                                              MaxHeight="260">
                                    <MediaElement.Style>
                                        <Style TargetType="MediaElement">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMediaAsset}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MediaElement.Style>
                                </MediaElement>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Dang cho hoc sinh tra loi..." FontSize="13" Foreground="#F59E0B" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            Padding="16,12"
                            CornerRadius="12,12,0,0"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Nhat ky hanh vi" FontSize="14" FontWeight="SemiBold" />
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,6" Background="#FAFAFA" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                       FontSize="11"
                                                       Foreground="#94A3B8"
                                                       FontFamily="Consolas"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Border CornerRadius="3" Padding="4,2" Margin="0,0,8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Info">
                                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Success">
                                                                    <Setter Property="Background" Value="#D1FAE5" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Error">
                                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>

                                                <TextBlock Text="{Binding Message}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
