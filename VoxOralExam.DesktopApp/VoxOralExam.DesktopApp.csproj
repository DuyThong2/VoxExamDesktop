<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.44.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="SIPSorcery" Version="10.0.8" />
    <PackageReference Include="SIPSorcery.VP8" Version="10.0.8" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.8" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoxOralExam.Core\VoxOralExam.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Lives at the solution root (..\.env, sibling to VoxOralExam.Core/VoxOralExam.DesktopApp),
         same convention as agents\.env: one secrets file per repo, not per project. Gitignored
         and may not exist on a fresh clone, so Include with a Condition (not Update) keeps the
         build from failing when it's missing. Link flattens it into the output dir as plain
         ".env" so DotEnvLoader.Load(BaseDirectory + ".env") finds it unchanged. -->
    <None Include="..\.env" Condition="Exists('..\.env')" Link=".env">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Native FFmpeg 8.1.x shared-build DLLs (avcodec/avformat/avutil/swscale/swresample/etc.) that
       SIPSorceryMedia.FFmpeg's FFmpegVideoEncoder needs at runtime; not bundled by the NuGet
       package (see FFmpeg.AutoGen's own README: "on Windows use ... obtain FFmpeg" separately).
       Must match FFmpeg.AutoGen's version exactly (8.1.0 here, so FFmpeg 8.1.x, per its semver
       convention) or native calls fail to resolve. Get the Windows x64 "shared" build (not
       "static"/"essentials", which has no individual .dll files) from gyan.dev/ffmpeg/builds,
       FFmpeg.AutoGen's own documented Windows source, and drop bin\*.dll here.
       Condition keeps a fresh clone buildable before anyone has populated this folder. -->
  <ItemGroup>
    <None Include="FFmpeg\*.dll" Condition="Exists('FFmpeg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ffmpeg\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
