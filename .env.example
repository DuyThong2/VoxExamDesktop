# Copy this file to .env (gitignored, solution root) and fill in real values.
# Every AppSettings (State/AppSettings.cs) field can be set here as UPPER_SNAKE_CASE of its C#
# property name (e.g. JavaBaseUrl -> JAVA_BASE_URL, S3BucketName -> S3_BUCKET_NAME) -- see
# Services/DotEnvLoader.cs's ApplyOverrides. Anything left unset here falls back to
# AppSettings.cs's own inline default. appsettings.json intentionally ships with no real values
# now -- this file (or AppSettings.cs's defaults) is the actual config source.

JAVA_BASE_URL=http://localhost:8081
PYTHON_BASE_URL=http://localhost:8000
WEB_RTC_SIGNALING_URL=ws://localhost:8082/signaling
STREAMING_BASE_URL=http://localhost:8082

# Local evidence recording and resumable segment upload
ENABLE_LOCAL_RECORDING=true
ENABLE_SEGMENT_UPLOAD=true
REQUIRE_RECORDING=true
RECORDING_SEGMENT_SECONDS=10
RECORDING_FINAL_DRAIN_SECONDS=20

# Dev-only: while USE_MOCK_DATA=true, also mint a real signed vox-streaming JWT from
# vox-streaming/demo/devserver (see that folder's README) instead of the hardcoded stub JWT, so
# the recording/upload pipeline above can be exercised against a real, locally-running
# vox-streaming instance. Requires vox-streaming's demo stack (docker compose + run-service) up
# and STREAMING_BASE_URL pointing at that instance's HTTP port.
USE_DEV_STREAM_TOKEN=false
DEV_STREAM_TOKEN_URL=http://localhost:8090

# Dev-only: skip login/OTP/exam-paper entirely and open Views/StreamingDemoWindow instead --
# a standalone screen (schedule id, user id, camera/screen checkboxes, start/stop) to exercise
# recording + segment upload against a real vox-streaming instance without needing exam data.
# Always mints its own token via DevStreamTokenClient/devserver, regardless of the two settings
# above. See AppSettings.LaunchStreamingDemo's doc comment.
LAUNCH_STREAMING_DEMO=false

# S3 (Services/TurnAudioUploader.cs)
S3_BUCKET_NAME=
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Turn timing
MAX_TURNS_PER_QUESTION=3
QUESTION_TURN_TIMEOUT_SECONDS=180
INITIAL_SILENCE_TIMEOUT_SECONDS=8
SILENCE_TIMEOUT_AFTER_REPEAT_SECONDS=12
TURN_AUDIO_PRE_ROLL_MILLISECONDS=400
TURN_AUDIO_TAIL_MILLISECONDS=500

# Camera
CAMERA_DEVICE_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

LOGIN_PLATFORM=DESKTOP

# Prototype: local avatar TTS (Services/LocalAvatarSpeaker.cs) -- same var names as agents/.env
AZURE_SPEECH_KEY=<your-azure-speech-key>
AZURE_SPEECH_REGION=eastus
AZURE_TTS_VOICE=en-US-JennyNeural

# Avatar WebRTC connection (video+audio track to Python's aiortc server) -- defaults false now
# that TTS moved to LocalAvatarSpeaker above; the connection no longer carries anything meaningful.
# Set true only to debug/revive that path. See AppSettings.cs's EnableAvatarWebRtc doc comment.
ENABLE_AVATAR_WEBRTC=false
