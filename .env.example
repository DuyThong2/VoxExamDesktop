# Copy this file to .env (gitignored, solution root) and fill in real values.
# Every AppSettings (State/AppSettings.cs) field can be set here as UPPER_SNAKE_CASE of its C#
# property name (e.g. JavaBaseUrl -> JAVA_BASE_URL, S3BucketName -> S3_BUCKET_NAME) -- see
# Services/DotEnvLoader.cs's ApplyOverrides. Anything left unset here falls back to
# AppSettings.cs's own inline default. appsettings.json intentionally ships with no real values
# now -- this file (or AppSettings.cs's defaults) is the actual config source.

JAVA_BASE_URL=http://localhost:8080
PYTHON_BASE_URL=http://localhost:8000
WEB_RTC_SIGNALING_URL=ws://localhost:8081/signaling

# S3 (Services/TurnAudioUploader.cs)
S3_BUCKET_NAME=
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Turn timing
MAX_TURNS_PER_QUESTION=3
QUESTION_TURN_TIMEOUT_SECONDS=180
INITIAL_SILENCE_TIMEOUT_SECONDS=8
SILENCE_TIMEOUT_AFTER_REPEAT_SECONDS=12
TURN_AUDIO_PRE_ROLL_MILLISECONDS=400
TURN_AUDIO_TAIL_MILLISECONDS=500

# Camera
CAMERA_DEVICE_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

LOGIN_PLATFORM=DESKTOP
