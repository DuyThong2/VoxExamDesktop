# Optional. Copy to .env.local (gitignored, solution root, sibling to .env) to override just the
# handful of keys that differ between "test against the live deployment" and "run everything
# local" -- loaded AFTER .env (see App.xaml.cs), so any key set here wins, and .env itself never
# needs editing back and forth when switching between the two.
#
# Everything NOT listed here (AWS creds, Azure Speech key, timing/camera settings, etc.) comes
# from .env as usual -- .env.local only needs the keys you actually want to differ.

JAVA_BASE_URL=http://localhost:8080
PYTHON_BASE_URL=http://localhost:8000
WEB_RTC_SIGNALING_URL=ws://localhost:8081/signaling

# vox-streaming chạy local (WEBRTC_ADDR=:8082 trong vox-streaming/.env). BẮT BUỘC phải có dòng
# này khi chạy local: .env đã trỏ STREAMING_BASE_URL sang https://stream.voxenta.net, mà .env.local
# chỉ ghi đè những key nó liệt kê -- thiếu dòng này là máy local vẫn bắn camera/màn hình lên
# deployment thật.
STREAMING_BASE_URL=http://localhost:8082

# Local dev has no coturn running -- leave blank to fall back to STUN-only, same as .env.example.
# Để trống là ĐÚNG, không phải thiếu sót: MonitorStreamClient/WebRtcClient tự bỏ qua TURN khi
# TURN_URL rỗng và vẫn thêm STUN, mà chạy local thì hai đầu cùng máy/cùng LAN nên candidate host
# đã đủ để ICE bắt tay.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
